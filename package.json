{
  "name": "homw-work-tracker",
  "version": "1.0.0",
  "description": "A Thai web app for teachers to record student work with QR codes. Teachers sign in with Google. Students do not need accounts.",
  "license": "ISC",
  "author": "smalldoc",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:p0": "playwright test --grep @P0",
    "test:e2e:p1": "playwright test --grep @P1",
    "test:e2e:list": "playwright test --list",
    "test:e2e:types": "tsc -p tests/e2e/tsconfig.json",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "exceljs": "^4.4.0",
    "jsqr": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2"
  }
}
